#!/usr/bin/env bash
#
# Container test for bearer token authentication.
#
# The test starts real containers and calls the API over HTTP. It checks that
# a configured token is required, that /health stays open for the Kubernetes
# probes, that a rejected request never starts a browser, and that an
# unconfigured token leaves the API open.
#
# Usage:
#   scripts/test-container-auth [IMAGE]
#
# Default: IMAGE=seleniumbase-scrapper:test
#
# Exit code 0 means the test passed. Any other exit code means it failed.

set -u

IMAGE="${1:-seleniumbase-scrapper:test}"
GUARDED="auth-test-guarded-$$-${RANDOM}"
OPEN="auth-test-open-$$-${RANDOM}"

TOKEN="first-token-value"
SECOND_TOKEN="second-token-value"
HEALTH_TIMEOUT=90
REQUEST_TIMEOUT=120

PAGE='<html><head><title>Auth page</title></head>'
PAGE+='<body><article><p>A local page for the auth test.</p></article></body></html>'
DATA_URL="data:text/html,${PAGE}"

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; NC=$'\033[0m'
failures=0

cleanup() {
    docker rm -f "$GUARDED" "$OPEN" >/dev/null 2>&1
}
trap cleanup EXIT INT TERM

fail() { echo "${RED}FAIL: $*${NC}"; failures=$((failures + 1)); }
pass() { echo "${GREEN}PASS: $*${NC}"; }

# Wait for the API inside a container, with a bounded timeout.
wait_for_api() {
    local container="$1"
    local i
    for i in $(seq 1 "$HEALTH_TIMEOUT"); do
        if docker exec "$container" curl -sf -m 2 \
            http://127.0.0.1:3000/health >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    return 1
}

# Print the HTTP status code for a request. Pass a path and optional header.
status() {
    local container="$1" path="$2" header="${3:-}"
    if [ -n "$header" ]; then
        docker exec "$container" curl -s -o /dev/null \
            -w '%{http_code}' -m "$REQUEST_TIMEOUT" \
            -H "$header" "http://127.0.0.1:3000${path}" 2>/dev/null
    else
        docker exec "$container" curl -s -o /dev/null \
            -w '%{http_code}' -m "$REQUEST_TIMEOUT" \
            "http://127.0.0.1:3000${path}" 2>/dev/null
    fi
}

# Print the response body for a request.
body() {
    local container="$1" path="$2" header="${3:-}"
    if [ -n "$header" ]; then
        docker exec "$container" curl -s -m "$REQUEST_TIMEOUT" \
            -H "$header" "http://127.0.0.1:3000${path}" 2>/dev/null
    else
        docker exec "$container" curl -s -m "$REQUEST_TIMEOUT" \
            "http://127.0.0.1:3000${path}" 2>/dev/null
    fi
}

# Print the response headers for a request.
head_lines() {
    local container="$1" path="$2"
    docker exec "$container" curl -s -D - -o /dev/null \
        -m "$REQUEST_TIMEOUT" "http://127.0.0.1:3000${path}" 2>/dev/null
}

# Print the HTTP status code for a scrape of the local page.
# The URL is passed with --data-urlencode, because the page markup contains
# characters that are not safe in a URL.
article_status() {
    local container="$1" header="${2:-}"
    if [ -n "$header" ]; then
        docker exec "$container" curl -s -o /dev/null \
            -w '%{http_code}' -m "$REQUEST_TIMEOUT" \
            -H "$header" -G --data-urlencode "url=${DATA_URL}" \
            "http://127.0.0.1:3000/api/article" 2>/dev/null
    else
        docker exec "$container" curl -s -o /dev/null \
            -w '%{http_code}' -m "$REQUEST_TIMEOUT" \
            -G --data-urlencode "url=${DATA_URL}" \
            "http://127.0.0.1:3000/api/article" 2>/dev/null
    fi
}

# Print the response body for a scrape of the local page.
article_body() {
    local container="$1" header="${2:-}"
    docker exec "$container" curl -s -m "$REQUEST_TIMEOUT" \
        -H "$header" -G --data-urlencode "url=${DATA_URL}" \
        "http://127.0.0.1:3000/api/article" 2>/dev/null
}

# Count the browser processes running inside a container.
browser_count() {
    docker exec "$1" ps -eo comm= 2>/dev/null \
        | grep -cE '^(chrome|chromium|uc_driver|chromedriver)'
}

# Check a status code and report the result.
expect_status() {
    local label="$1" expected="$2" actual="$3"
    if [ "$actual" = "$expected" ]; then
        pass "$label returned HTTP $actual"
    else
        fail "$label returned HTTP $actual, expected $expected"
    fi
}

echo "${YELLOW}=============================================${NC}"
echo "${YELLOW}Container bearer token test${NC}"
echo "${YELLOW}=============================================${NC}"
echo "Image: $IMAGE"
echo ""

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "${RED}Image $IMAGE is not present. Build it first.${NC}"
    exit 1
fi

#--------------------------------------------------
# Part 1: a container with two configured tokens.
#--------------------------------------------------
echo "--- Part 1: API_TOKEN is set"
if ! docker run -d --name "$GUARDED" \
        -e "API_TOKEN=${TOKEN}, ${SECOND_TOKEN}" "$IMAGE" >/dev/null; then
    echo "${RED}Could not start the guarded container.${NC}"
    exit 1
fi
if ! wait_for_api "$GUARDED"; then
    echo "${RED}The API never became ready.${NC}"
    docker logs "$GUARDED" 2>&1 | tail -30
    exit 1
fi

expect_status "/health with no token" 200 "$(status "$GUARDED" /health)"
expect_status "/ with no token" 401 "$(status "$GUARDED" /)"
expect_status "/ with a wrong token" 401 \
    "$(status "$GUARDED" / 'Authorization: Bearer wrong-token')"
expect_status "/ with the first token" 200 \
    "$(status "$GUARDED" / "Authorization: Bearer ${TOKEN}")"
expect_status "/ with the second token" 200 \
    "$(status "$GUARDED" / "Authorization: Bearer ${SECOND_TOKEN}")"
expect_status "/ with a lowercase scheme" 200 \
    "$(status "$GUARDED" / "Authorization: bearer ${TOKEN}")"
expect_status "/ with a Basic scheme" 401 \
    "$(status "$GUARDED" / 'Authorization: Basic Zm9vOmJhcg==')"
expect_status "/api/article with a token in the query string" 401 \
    "$(status "$GUARDED" "/api/article?url=http://example.com&token=${TOKEN}")"

# The 401 must advertise the scheme and must not leak a token.
headers="$(head_lines "$GUARDED" /)"
if echo "$headers" | grep -qi '^WWW-Authenticate: Bearer'; then
    pass "the 401 carries WWW-Authenticate: Bearer"
else
    fail "the 401 has no WWW-Authenticate: Bearer header"
fi

rejected_body="$(body "$GUARDED" / 'Authorization: Bearer wrong-token')"
echo "  401 body: $rejected_body"
if echo "$rejected_body" | grep -q 'invalid_token'; then
    pass "the 401 body reports invalid_token"
else
    fail "the 401 body does not report invalid_token"
fi
if echo "$rejected_body" | grep -qF "$TOKEN"; then
    fail "the 401 body leaks the configured token"
else
    pass "the 401 body leaks no token"
fi

# A rejected scrape must never start a browser.
before="$(browser_count "$GUARDED")"
code="$(article_status "$GUARDED")"
after="$(browser_count "$GUARDED")"
expect_status "/api/article with no token" 401 "$code"
echo "  browser processes before=$before after=$after"
if [ "$after" -le "$before" ]; then
    pass "the rejected scrape started no browser"
else
    fail "the rejected scrape started $((after - before)) browser process(es)"
fi

# A scrape with a valid token must work end to end.
code="$(article_status "$GUARDED" "Authorization: Bearer ${TOKEN}")"
expect_status "/api/article with the first token" 200 "$code"

scraped="$(article_body "$GUARDED" "Authorization: Bearer ${TOKEN}")"
if echo "$scraped" | grep -q 'Auth page'; then
    pass "the authenticated scrape returned the page title"
else
    fail "the authenticated scrape did not return the page title"
fi
echo ""

#--------------------------------------------------
# Part 2: a container with no configured token.
#--------------------------------------------------
echo "--- Part 2: API_TOKEN is unset"
if ! docker run -d --name "$OPEN" "$IMAGE" >/dev/null; then
    echo "${RED}Could not start the open container.${NC}"
    exit 1
fi
if ! wait_for_api "$OPEN"; then
    echo "${RED}The API never became ready.${NC}"
    docker logs "$OPEN" 2>&1 | tail -30
    exit 1
fi

expect_status "/health with no token" 200 "$(status "$OPEN" /health)"
expect_status "/ with no token" 200 "$(status "$OPEN" /)"
expect_status "/api/article with no token" 200 \
    "$(article_status "$OPEN")"

if docker logs "$OPEN" 2>&1 | grep -q 'API_TOKEN is not set'; then
    pass "the log warns that the API is open"
else
    fail "the log does not warn that the API is open"
fi
echo ""

echo "${YELLOW}=============================================${NC}"
if [ "$failures" -eq 0 ]; then
    echo "${GREEN}All container auth checks passed.${NC}"
    echo "${YELLOW}=============================================${NC}"
    exit 0
fi
echo "${RED}${failures} container auth check(s) failed.${NC}"
echo "${YELLOW}=============================================${NC}"
exit 1

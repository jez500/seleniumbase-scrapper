#!/usr/bin/env bash
#
# Container regression test for the zombie-process leak.
#
# The test starts a real container, scrapes a local HTML data URL many times
# with a real browser, and counts zombie processes inside the container after
# every scrape. It also exercises a navigation error, a browser start failure
# and a graceful container shutdown.
#
# Usage:
#   scripts/test-container-zombies [IMAGE] [ITERATIONS]
#
# Defaults: IMAGE=seleniumbase-scrapper:fix, ITERATIONS=10
#
# Exit code 0 means the test passed. Any other exit code means it failed.

set -u

IMAGE="${1:-seleniumbase-scrapper:fix}"
ITERATIONS="${2:-10}"
CONTAINER="zombie-test-$$-${RANDOM}"

# Bounded timeouts, in seconds.
HEALTH_TIMEOUT=90
SCRAPE_TIMEOUT=120
STOP_TIMEOUT=30

# A local HTML document. The test never reaches an external website.
PAGE='<html><head><title>Regression page</title>'
PAGE+='<meta name="description" content="Local page for the zombie test">'
PAGE+='</head><body><article><h1>Heading</h1>'
PAGE+='<p>First paragraph of the regression page.</p>'
PAGE+='<p>Second paragraph of the regression page.</p>'
PAGE+='</article></body></html>'
DATA_URL="data:text/html,${PAGE}"

# A URL that no server answers. It exercises the unreachable URL path.
BAD_URL='http://127.0.0.1:9/never-listens'

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; NC=$'\033[0m'
failures=0

cleanup() {
    docker rm -f "$CONTAINER" >/dev/null 2>&1
}
trap cleanup EXIT INT TERM

fail() {
    echo "${RED}FAIL: $*${NC}"
    failures=$((failures + 1))
}

pass() {
    echo "${GREEN}PASS: $*${NC}"
}

# Print "pid ppid state comm" for every process in the container.
snapshot() {
    docker exec "$CONTAINER" ps -eo pid=,ppid=,stat=,comm= 2>/dev/null
}

zombie_count() {
    snapshot | awk '$3 ~ /Z/' | grep -c .
}

zombie_detail() {
    snapshot | awk '$3 ~ /Z/ {print "      zombie pid=" $1 " ppid=" $2 " comm=" $4}'
}

process_count() {
    snapshot | grep -c .
}

scrape() {
    local url="$1"
    docker exec "$CONTAINER" curl -s -o /dev/null \
        -w '%{http_code}' -m "$SCRAPE_TIMEOUT" \
        -G --data-urlencode "url=${url}" \
        "http://127.0.0.1:3000/api/article" 2>/dev/null
}

# Print one line of process counts and set LAST_ZOMBIES to the zombie count.
LAST_ZOMBIES=0
report() {
    local label="$1"
    local procs
    procs="$(process_count)"
    LAST_ZOMBIES="$(zombie_count)"
    printf '  %-36s processes=%-4s zombies=%s\n' "$label" "$procs" "$LAST_ZOMBIES"
    if [ "$LAST_ZOMBIES" -gt 0 ]; then
        zombie_detail
    fi
}

echo "${YELLOW}=============================================${NC}"
echo "${YELLOW}Container zombie regression test${NC}"
echo "${YELLOW}=============================================${NC}"
echo "Image:      $IMAGE"
echo "Iterations: $ITERATIONS"
echo ""

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "${RED}Image $IMAGE is not present. Build it first.${NC}"
    exit 1
fi

# Start the container with no --init flag. The image must reap orphans itself.
if ! docker run -d --name "$CONTAINER" "$IMAGE" >/dev/null; then
    echo "${RED}Could not start the container.${NC}"
    exit 1
fi

# Wait for the API, with a bounded timeout.
ready=0
for _ in $(seq 1 "$HEALTH_TIMEOUT"); do
    if docker exec "$CONTAINER" curl -sf -m 2 http://127.0.0.1:3000/health >/dev/null 2>&1; then
        ready=1
        break
    fi
    sleep 1
done
if [ "$ready" -ne 1 ]; then
    echo "${RED}The API never became ready.${NC}"
    docker logs "$CONTAINER" 2>&1 | tail -30
    exit 1
fi

#--------------------------------------------------
# Check 1: PID 1 must be an init process.
#--------------------------------------------------
echo "--- Check 1: PID 1 is an init process"
pid1="$(docker exec "$CONTAINER" sh -c 'tr "\0" " " < /proc/1/cmdline')"
echo "  PID 1 cmdline: $pid1"
case "$pid1" in
    *tini*) pass "PID 1 runs tini" ;;
    *)      fail "PID 1 does not run tini: $pid1" ;;
esac
echo ""

#--------------------------------------------------
# Check 2: repeated scrapes must not grow the zombie count.
#--------------------------------------------------
echo "--- Check 2: repeated scrapes of a local HTML page"
report 'baseline (no scrape yet)'
worst=0
for i in $(seq 1 "$ITERATIONS"); do
    code="$(scrape "$DATA_URL")"
    if [ "$code" != "200" ]; then
        fail "scrape $i returned HTTP $code, expected 200"
    fi
    report "after scrape $i (HTTP $code)"
    if [ "$LAST_ZOMBIES" -gt "$worst" ]; then
        worst="$LAST_ZOMBIES"
    fi
done
if [ "$worst" -eq 0 ]; then
    pass "no zombie appeared during $ITERATIONS scrapes"
else
    fail "the peak zombie count was $worst, expected 0"
fi
echo ""

#--------------------------------------------------
# Check 3: the unreachable URL path.
#--------------------------------------------------
echo "--- Check 3: unreachable URL path"
for i in 1 2 3; do
    code="$(scrape "$BAD_URL")"
    report "after failed scrape $i (HTTP $code)"
    if [ "$LAST_ZOMBIES" -gt 0 ]; then
        fail "the unreachable URL path left $LAST_ZOMBIES zombie(s)"
    fi
done
if [ "$LAST_ZOMBIES" -eq 0 ]; then
    pass "the unreachable URL path left no zombie"
fi
echo ""

#--------------------------------------------------
# Check 4: the browser start failure path.
# Hiding the Chrome binary makes Driver() fail part way through.
#--------------------------------------------------
echo "--- Check 4: browser start failure path"
# SeleniumBase resolves Chrome through /opt/google/chrome or the Chromium
# package. Hiding every candidate makes Driver() fail part way through.
hidden=""
for candidate in /opt/google/chrome/chrome /opt/google/chrome/google-chrome \
                 /usr/bin/google-chrome /usr/lib/chromium-browser/chromium-browser \
                 /usr/bin/chromium-browser; do
    if docker exec "$CONTAINER" test -e "$candidate"; then
        docker exec "$CONTAINER" mv "$candidate" "${candidate}.hidden"
        hidden="$hidden $candidate"
    fi
done
if [ -z "$hidden" ]; then
    echo "  No Chrome binary found. Skipping this check."
else
    code="$(scrape "$DATA_URL")"
    for candidate in $hidden; do
        docker exec "$CONTAINER" mv "${candidate}.hidden" "$candidate"
    done
    report "after browser start failure (HTTP $code)"
    if [ "$code" = "200" ]; then
        fail "the scrape returned 200, so Chrome did not fail to start"
    else
        pass "Driver() failed as intended (HTTP $code)"
    fi
    if [ "$LAST_ZOMBIES" -gt 0 ]; then
        fail "the browser start failure path left $LAST_ZOMBIES zombie(s)"
    else
        pass "the browser start failure path left no zombie"
    fi
    # The API must still work after the failure.
    code="$(scrape "$DATA_URL")"
    if [ "$code" = "200" ]; then
        pass "the API still answers after a browser start failure"
    else
        fail "the API returned HTTP $code after a browser start failure"
    fi
    report "after recovery scrape"
    if [ "$LAST_ZOMBIES" -gt 0 ]; then
        fail "the recovery scrape left $LAST_ZOMBIES zombie(s)"
    fi
fi
echo ""

#--------------------------------------------------
# Check 5: graceful shutdown.
#--------------------------------------------------
echo "--- Check 5: graceful container shutdown"
start_time="$(date +%s)"
docker stop -t "$STOP_TIMEOUT" "$CONTAINER" >/dev/null 2>&1
elapsed="$(( $(date +%s) - start_time ))"
exit_code="$(docker inspect -f '{{.State.ExitCode}}' "$CONTAINER" 2>/dev/null)"
echo "  stop took ${elapsed}s, container exit code $exit_code"
if [ "$elapsed" -lt "$STOP_TIMEOUT" ]; then
    pass "the container stopped before the ${STOP_TIMEOUT}s kill timeout"
else
    fail "the container needed the ${STOP_TIMEOUT}s kill timeout"
fi
echo ""

echo "${YELLOW}=============================================${NC}"
if [ "$failures" -eq 0 ]; then
    echo "${GREEN}All container zombie checks passed.${NC}"
    echo "${YELLOW}=============================================${NC}"
    exit 0
fi
echo "${RED}${failures} container zombie check(s) failed.${NC}"
echo "${YELLOW}=============================================${NC}"
exit 1
